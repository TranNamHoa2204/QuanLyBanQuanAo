<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" version="2.2">
  <persistence-unit name="QuanAoPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>server.entities.NhanVien</class>
    <class>server.entities.TaiKhoan</class>
    <class>server.entities.SanPham</class>
    <class>server.entities.BienThe</class>
    <class>server.entities.AnhSanPham</class>
    <class>server.entities.LoaiSanPham</class>
    <class>server.entities.ThuongHieu</class>
    <class>server.entities.HoaDon</class>
    <class>server.entities.ChiTietHoaDon</class>
    <class>server.entities.KhachHang</class>
    <class>server.entities.KhuyenMai</class>
    <class>server.entities.Thue</class>
    <class>server.entities.LichSuKho</class>
    <class>server.entities.NhaCungCap</class>
    <class>server.entities.PhieuNhap</class>
    <class>server.entities.ChiTietPhieuNhap</class>
    <class>server.entities.PhieuNhapThaoTac</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServer2012Dialect"/>
      <!-- Không tự tạo/xóa/sửa bảng của người dùng. -->
      <property name="hibernate.hbm2ddl.auto" value="validate"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.jdbc.time_zone" value="Asia/Ho_Chi_Minh"/>
    </properties>
  </persistence-unit>
</persistence>
